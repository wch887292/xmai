/* 全局样式 */
page {
  background: #f2f0f7;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #2d2840;
  font-size: 28rpx;
  line-height: 1.5;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(60, 46, 92, 0.06);
}

.title { font-size: 34rpx; font-weight: 600; }
.subtitle { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.muted { color: #9a93b5; font-size: 24rpx; }
.red { color: #e74c3c; }
.green { color: #27ae60; }

.btn {
  background: #6c5ce7;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 40rpx;
  text-align: center;
  line-height: 1.4;
}
.btn-ghost {
  background: #efeafc;
  color: #6c5ce7;
}
.btn-danger {
  background: #fdecea;
  color: #e74c3c;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 24rpx 0;
}

.link { color: #6c5ce7; text-decoration: underline; }
button.agree-btn::after { border: none; }
.btn-block { width: 100%; box-sizing: border-box; margin-top: 20rpx; }
.btn[disabled] { opacity: 0.5; }

.row { display: flex; gap: 20rpx; align-items: center; }
.row-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }

.field { margin-bottom: 24rpx; }
.field-label { font-size: 26rpx; color: #6b6390; margin-bottom: 10rpx; }
.field-control {
  background: #f6f4fc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

/* 备份弹层 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(30, 20, 50, 0.45);
  display: flex; align-items: flex-end; z-index: 50;
}
.sheet {
  background: #fff; width: 100%; box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0; padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
.imp {
  width: 100%; box-sizing: border-box; height: 220rpx; margin-top: 16rpx;
  background: #f6f4fc; border-radius: 16rpx; padding: 20rpx; font-size: 24rpx;
}
