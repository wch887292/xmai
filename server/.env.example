# 服务端口
PORT=3000

# 微信小程序 AppID / AppSecret
# 注意：AppSecret 仅存于服务端环境变量，绝不写入前端代码或代码仓库。
# 之前在聊天中暴露过的 Secret 建议去微信后台「重置」后填入新值。
WECHAT_APPID=wx0000000000000000   # 占位示例：请填你自己的小程序 AppID（勿提交真实值）
WECHAT_SECRET=在此填入你的小程序密钥

# 数据存储目录（容器内部路径，建议云托管挂载持久卷；本地用 ./data）
DATA_DIR=./data

# 本地测试开关：true 时允许用 devPhone 直接登录（绕过微信 code）。
# 生产部署必须设为 false，否则任何人可伪造手机号登录。
DEV_MODE=false
