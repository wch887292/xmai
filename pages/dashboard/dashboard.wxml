<view class="page">
  <view class="card">
    <view class="subtitle">近 7 天概览</view>
    <view class="metrics">
      <view class="metric">
        <view class="m-num">{{weekAvg}}</view>
        <view class="muted">平均时长</view>
      </view>
      <view class="metric">
        <view class="m-num">{{avgQuality}}</view>
        <view class="muted">平均质量</view>
      </view>
      <view class="metric">
        <view class="m-num">{{onTimeRate}}</view>
        <view class="muted">达标率</view>
      </view>
      <view class="metric">
        <view class="m-num">{{bestDur}}</view>
        <view class="muted">最长一夜</view>
      </view>
    </view>
    <view class="muted" style="margin-top:8rpx;">最近 7 天共记录 {{nights}} 晚</view>
  </view>

  <view class="card">
    <view class="subtitle">睡眠质量趋势（★）</view>
    <canvas type="2d" id="lineChart" class="chart"></canvas>
  </view>

  <view class="card">
    <view class="subtitle">睡眠时长（柱状）</view>
    <canvas type="2d" id="barChart" class="chart"></canvas>
  </view>
</view>
