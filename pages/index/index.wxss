.hero {
  background: linear-gradient(135deg, #6c5ce7 0%, #4834a6 100%);
  color: #fff;
}
.hero-top {
  display: flex; justify-content: space-between; align-items: center;
}
.hero-top .title { color: #fff; }
.hero-top .muted { color: rgba(255,255,255,0.75); }
.backup-btn {
  background: rgba(255,255,255,0.18);
  color: #fff; font-size: 24rpx;
  padding: 10rpx 24rpx; border-radius: 999rpx;
}
.hero-actions { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; }
.login-chip {
  background: rgba(255,255,255,0.28);
  color: #fff; font-size: 24rpx; max-width: 220rpx;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.hero-stats {
  display: flex; justify-content: space-around;
  margin-top: 28rpx; text-align: center;
}
.stat-num { font-size: 40rpx; font-weight: 700; }
.hero-stats .muted { color: rgba(255,255,255,0.75); margin-top: 4rpx; }
.user-count {
  text-align: center; font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 22rpx; letter-spacing: 1rpx;
}

.task {
  display: flex; align-items: center;
  padding: 20rpx 0; border-top: 1rpx solid #f0eef7;
}
.task-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #6c5ce7; margin-right: 18rpx; flex-shrink: 0;
}
.task-red .task-dot { background: #e74c3c; }
.task-text { flex: 1; font-size: 28rpx; }
.task-red .task-text { color: #e74c3c; font-weight: 600; }
.task-btn { padding: 12rpx 28rpx; font-size: 24rpx; }

.quick {
  display: flex; justify-content: space-around; text-align: center;
}
.quick-item { display: flex; flex-direction: column; align-items: center; }
.quick-ico {
  width: 92rpx; height: 92rpx; border-radius: 24rpx;
  background: #efeafc; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; margin-bottom: 12rpx;
}
.quick-label { font-size: 24rpx; color: #6b6390; }

.energy-card {
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #00b894 0%, #0984a6 100%);
  color: #fff;
}
.ec-left { display: flex; align-items: center; }
.ec-icon { font-size: 56rpx; margin-right: 20rpx; }
.ec-num { font-size: 40rpx; font-weight: 800; }
.ec-unit { font-size: 24rpx; font-weight: 400; opacity: 0.9; }
.energy-card .muted { color: rgba(255,255,255,0.85); }
.ec-arrow { font-size: 48rpx; opacity: 0.7; }

.ai-entry { display: flex; align-items: center; }
.ai-emoji { font-size: 52rpx; margin-right: 18rpx; }
.ai-text { flex: 1; }
.ai-name { font-size: 30rpx; font-weight: 600; }
.ai-entry .muted { margin-top: 4rpx; }
.ai-badge {
  font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx;
  background: #6c5ce7; color: #fff;
}
.ai-locked .ai-badge { background: #c8c2e0; }

.foot { text-align: center; padding: 30rpx 0 50rpx; }
.foot .link { color: #6c5ce7; font-size: 24rpx; }
.foot-dot { color: #ccc; margin: 0 16rpx; }

/* 云同步条 */
.sync-bar { display: flex; align-items: center; justify-content: space-between; }
.sb-title { font-size: 28rpx; font-weight: 600; color: #3a2e5c; }
.sb-btns { display: flex; gap: 16rpx; }
.btn-sm { padding: 12rpx 24rpx; font-size: 24rpx; }
